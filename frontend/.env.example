# Copy to .env.local and fill in. Next.js refuses to render any page without
# the Clerk keys — <ClerkProvider> throws at render time when they are missing.

# Clerk — dashboard > "API Keys". The publishable key is public by design and
# is inlined into the browser bundle; the secret key is server-only and must
# never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# Where Clerk's components send users. These must match the app's routes, both
# of which are catch-all segments so Clerk can own its multi-step sub-routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Backend origins, as seen from the browser — not from inside the compose
# network, since these URLs are fetched by client components. They must also
# appear in each service's ALLOWED_ORIGINS, and this app's origin must be in
# their CLERK_AUTHORIZED_PARTIES, or the token's `azp` check rejects it.
NEXT_PUBLIC_DOCUMENT_API_URL=http://localhost:6060
NEXT_PUBLIC_RAG_API_URL=http://localhost:7000
