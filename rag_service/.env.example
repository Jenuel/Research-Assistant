# Copy to .env and fill in. The service refuses to start without the CLERK_* values.

GEMINI_API_KEY=

# Generation model. Defaults to gemini-3.5-flash when unset. Avoid dated
# preview aliases (e.g. gemini-2.5-flash-preview-04-17): they are retired on a
# schedule, and once retired every query 404s.
GEMINI_MODEL=gemini-3.5-flash

# Clerk — must match the values used by document_service.
CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev

# Comma-separated origins allowed to mint tokens for this API (the `azp` claim).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Comma-separated CORS origins.
ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
# All limit values use slowapi limit-string syntax; ";" combines windows. An
# unparseable value falls back to the built-in default — there is no
# "unlimited" setting.

# Per-user limits on /api/rag/generate, keyed on the Clerk user ID. Two windows
# because the failure modes differ: the burst limit stops a hot loop, the daily
# limit is what bounds one user's share of the Gemini bill.
GENERATE_RATE_LIMITS=10/minute;200/day

# App-wide ceiling on /api/rag/generate, shared by every caller. The per-user
# limit above does not bound total spend: a hundred users — or one attacker
# with a hundred Clerk accounts — can each stay inside 200/day. This is the
# number that caps the actual bill.
GLOBAL_GENERATE_RATE_LIMITS=2000/day

# Pre-auth limit, keyed on client IP and applied by middleware before token
# verification. This is what stands in front of unauthenticated traffic — the
# per-user limits above cannot, because they run only after the Clerk
# dependency has already verified a token. It is a denial-of-service guard
# rather than a quota, hence the generous value.
PREAUTH_RATE_LIMITS=120/minute

# Rate-limit counter storage. "memory://" is per process, so N Uvicorn workers
# allow N x the configured rate and every restart resets the counters —
# including the daily spend caps. Use Redis for limits that hold across workers
# and replicas, e.g. redis://cache:6379 (docker-compose sets this
# automatically). Matters more here than on upload: these requests cost money.
RATE_LIMIT_STORAGE_URI=memory://

# Counting strategy. "moving-window" counts over a rolling interval.
# "fixed-window" resets on wall-clock boundaries, which lets a client spend its
# whole allowance at the end of one window and again at the start of the next.
RATE_LIMIT_STRATEGY=moving-window

# What to do when the counter store is unreachable. true = allow the request
# and log (availability over enforcement); false = reject.
RATE_LIMIT_FAIL_OPEN=true

# "production" or "staging" turns the memory:// storage notice into a warning.
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR. Defaults to INFO, and anything
# unrecognized also falls back to INFO.
LOG_LEVEL=INFO

# Only relevant behind a reverse proxy or load balancer. Uvicorn reads this
# natively: set it to the proxy's address so the real client IP is recovered
# from X-Forwarded-For. Leave it unset when clients connect directly — and do
# NOT set it to "*" in production, since anyone could then spoof their IP and
# escape the pre-auth limit. Without it, every request behind a proxy appears
# to come from the proxy and shares one bucket.
# FORWARDED_ALLOW_IPS=10.0.0.1
