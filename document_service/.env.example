# Copy to .env and fill in. The service refuses to start without the CLERK_* values.

DATABASE_URL=postgresql://postgres:password@postgresdb:5432/document_service

# Clerk — find these in your Clerk dashboard under "API Keys" / "Show JWT public key".
# CLERK_ISSUER is your Frontend API URL; JWKS lives at <issuer>/.well-known/jwks.json
CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev

# Comma-separated origins allowed to mint tokens for this API (the `azp` claim).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Comma-separated CORS origins.
ALLOWED_ORIGINS=http://localhost:3000

# Maximum accepted upload size in bytes. Defaults to 10485760 (10 MB), which is
# what the frontend upload dialog advertises. Anything unset, non-numeric, or
# non-positive falls back to that default — there is no "unlimited" setting.
MAX_UPLOAD_BYTES=10485760

# --- Rate limiting ---------------------------------------------------------
# All limit values use slowapi limit-string syntax; combine windows with ";"
# (e.g. "20/minute;500/day"). An unparseable value falls back to the built-in
# default — there is no "unlimited" setting.

# Per-user limits, keyed on the verified Clerk user ID. These are the fair-use
# budget for legitimate callers.
UPLOAD_RATE_LIMITS=20/minute
READ_RATE_LIMITS=120/minute
DELETE_RATE_LIMITS=60/minute

# Pre-auth limit, keyed on client IP and applied by middleware before token
# verification and before the request body is read. This is what stands in
# front of unauthenticated traffic — the per-user limits above cannot, because
# they run only after the Clerk dependency has already verified a token.
# Deliberately generous: it is a denial-of-service guard, not a quota, and must
# stay above what several users behind one office NAT would produce.
PREAUTH_RATE_LIMITS=120/minute

# Rate-limit counter storage. "memory://" is per process, so N Uvicorn workers
# allow N x the configured rate and every restart resets the counters. Use
# Redis for limits that hold across workers and replicas, e.g.
# redis://cache:6379 (docker-compose sets this automatically).
RATE_LIMIT_STORAGE_URI=memory://

# Counting strategy. "moving-window" counts over a rolling interval.
# "fixed-window" resets on wall-clock boundaries, which lets a client spend its
# whole allowance at the end of one window and again at the start of the next —
# a 2x burst the limit string does not reveal.
RATE_LIMIT_STRATEGY=moving-window

# What to do when the counter store is unreachable. true = allow the request
# and log (availability over enforcement); false = reject. Leave true unless
# enforcement matters more to you than uptime.
RATE_LIMIT_FAIL_OPEN=true

# "production" or "staging" turns the memory:// storage notice into a warning.
APP_ENV=development

# Only relevant behind a reverse proxy or load balancer. Uvicorn reads this
# natively: set it to the proxy's address so the real client IP is recovered
# from X-Forwarded-For. Leave it unset when clients connect directly — and do
# NOT set it to "*" in production, since anyone could then spoof their IP and
# escape the pre-auth limit. Without it, every request behind a proxy appears
# to come from the proxy and shares one bucket.
# FORWARDED_ALLOW_IPS=10.0.0.1

# Log level: DEBUG | INFO | WARNING | ERROR. Defaults to INFO, and anything
# unrecognized also falls back to INFO. Leave it at INFO in production — DEBUG
# emits filenames and Clerk user IDs into the logs.
LOG_LEVEL=INFO
